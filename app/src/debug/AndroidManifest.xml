<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Keep local debug sessions out of the production Crashlytics dashboard. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />

        <!-- ADB-only test entry point; debug source set is never packaged in release. -->
        <activity
            android:name=".debug.CrashlyticsSmokeTestActivity"
            android:exported="true" />
    </application>
</manifest>
