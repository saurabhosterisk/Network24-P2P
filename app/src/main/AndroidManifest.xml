<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The app needs Android 7.0 (API 24) - WireGuard (in-app VPN) requires
         it. minSdk is kept at 21 only so older devices can still install it
         and see the "device not supported" screen (UnsupportedDeviceGate)
         instead of Android's bare "App not installed". On those devices the
         app stops before login, so no VPN code ever runs. -->
    <uses-sdk tools:overrideLibrary="com.wireguard.android.tunnel,com.google.firebase.auth,com.google.firebase.auth.ktx" />


    <!-- Internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Normal (no runtime prompt) permissions the in-app stream diagnostics
         screen needs. Without these declared, ConnectivityManager and
         WifiManager silently return redacted info on some OS versions - the
         network type showed as "Other" instead of "WiFi", and WiFi signal
         strength/link speed always came back unavailable. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Install APK support -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 13+ only -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="33" />


    <!-- Android TV / Fire TV -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.type.television"
        android:required="false" />

    <!-- Android 11+ hides other apps' packages unless declared here. Needed
         so DashboardActivity's Cinema Pro 3 launcher can both look up the
         known package by name AND fall back to scanning installed launcher
         apps by label/package when that exact name doesn't match (a Cinema
         Pro 3 build with a slightly different applicationId, for example). -->
    <queries>
        <package android:name="com.infahash.fvision.cpro3" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>


    <application

        android:name=".Network24App"

        android:allowBackup="true"

        android:dataExtractionRules="@xml/data_extraction_rules"

        android:fullBackupContent="@xml/backup_rules"

        android:icon="@mipmap/ic_launcher"

        android:roundIcon="@mipmap/ic_launcher_round"

        android:label="@string/app_name"

        android:banner="@mipmap/tv_banner"

        android:supportsRtl="true"

        android:resizeableActivity="true"

        android:usesCleartextTraffic="true"

        android:theme="@style/Theme.Network24">


        <!-- File Provider -->

        <provider

            android:name="androidx.core.content.FileProvider"

            android:authorities="${applicationId}.provider"

            android:exported="false"

            android:grantUriPermissions="true">


            <meta-data

                android:name="android.support.FILE_PROVIDER_PATHS"

                android:resource="@xml/file_paths" />

        </provider>



        <!-- Remote Help & Easy Mode (core/remote) -->
        <activity
            android:name=".core.remote.EasyHomeActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <!-- Player -->

        <activity
            android:name=".features.player.activity.PlayerActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />


        <activity
            android:name=".features.player.multiview.MultiViewActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />



        <!-- Live -->

        <activity
            android:name=".features.live.activity.ChannelListActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />


        <activity
            android:name=".features.live.activity.EpgChannelListActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />



        <activity
            android:name=".features.live.activity.MasterChannelSearchActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />


        <activity
            android:name=".features.live.activity.FavoriteChannelsActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />


        <activity
            android:name=".features.live.activity.LiveCategoryActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".features.live.activity.RecentlyWatchedActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />


        <activity
            android:name=".features.live.activity.ManageCategoriesActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".features.parental.ParentalLockActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />



        <!-- Login -->

        <activity
            android:name=".features.login.activity.LoginActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />



        <!-- Dashboard -->

        <activity
            android:name=".features.dashboard.activity.DashboardActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />



        <!-- Settings -->

        <activity
            android:name=".features.settings.activity.SettingsActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".features.settings.activity.AutoRefreshActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".features.settings.activity.AutoCleanActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".features.settings.activity.AutoReconnectActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".features.settings.activity.AboutDeviceActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".features.support.activity.LiveSupportActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- Discover: events & scores, trending, show search, catch-up, reminders, account -->
        <activity
            android:name=".features.discover.EventsActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan|stateHidden" />
        <activity
            android:name=".features.discover.GameActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".features.discover.EventActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".features.discover.TeamActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan|stateHidden" />
        <activity
            android:name=".features.discover.TrendingActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".features.discover.ShowSearchActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan|stateHidden" />
        <activity
            android:name=".features.catchup.CatchupActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".features.guide.TvGuideActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".features.livetv.LiveTvActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".features.sports.SportsActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".features.catchup.CatchupPlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".features.reminders.RemindersActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".features.account.AccountActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".features.discover.WatchLinkActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <receiver
            android:name=".features.reminders.ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".features.discover.TeamGameReceiver"
            android:exported="false" />



        <!-- Launcher -->

        <activity

            android:name=".features.splash.activity.SplashActivity"

            android:exported="true"

            android:screenOrientation="sensorLandscape"

            android:banner="@mipmap/tv_banner">


            <intent-filter>

                <action android:name="android.intent.action.MAIN" />


                <category android:name="android.intent.category.LAUNCHER" />


                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />

            </intent-filter>


        </activity>


    </application>


</manifest>
