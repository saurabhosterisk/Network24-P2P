<?xml version="1.0" encoding="utf-8"?>
<!-- Quiet secondary button (e.g. Exit); white outline on remote focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="@color/selection_surface"/><corners android:radius="20dp"/><stroke android:width="1dp" android:color="@color/text_hint"/></shape></item>
    <item android:state_focused="true"><shape><solid android:color="@color/selection_surface"/><corners android:radius="20dp"/><stroke android:width="2dp" android:color="@color/focus"/></shape></item>
    <item><shape><solid android:color="@android:color/transparent"/><corners android:radius="20dp"/><stroke android:width="1dp" android:color="@color/divider"/></shape></item>
</selector>
