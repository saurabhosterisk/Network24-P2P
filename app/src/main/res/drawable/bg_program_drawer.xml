<?xml version="1.0" encoding="utf-8"?>
<!-- "What's playing" panel on the left: almost solid, so the player's own
     controls and subtitles don't show through the text. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#F5171422" android:endColor="#F20E0C15" />
            <corners android:topRightRadius="20dp" android:bottomRightRadius="20dp" />
        </shape>
    </item>
    <!-- thin highlight on the open edge -->
    <item android:gravity="end" android:width="1dp" android:top="20dp" android:bottom="20dp">
        <shape><solid android:color="#33FFFFFF" /></shape>
    </item>
</layer-list>
