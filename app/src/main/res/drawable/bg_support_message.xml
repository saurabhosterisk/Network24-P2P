<?xml version="1.0" encoding="utf-8"?>
<!-- A message row: transparent until focused with the TV remote. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="@color/selection_surface"/><corners android:radius="10dp"/></shape></item>
    <item android:state_focused="true"><shape><solid android:color="@color/selection_surface"/><corners android:radius="10dp"/><stroke android:width="2dp" android:color="@color/selection_stroke"/></shape></item>
    <item><shape><solid android:color="@android:color/transparent"/><corners android:radius="10dp"/></shape></item>
</selector>
