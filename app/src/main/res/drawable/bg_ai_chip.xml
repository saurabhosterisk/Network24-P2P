<?xml version="1.0" encoding="utf-8"?>
<!-- Ready-made question / answer choice; white outline on remote focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="@color/selection_surface_pressed"/><corners android:radius="18dp"/><stroke android:width="1dp" android:color="@color/primary_light"/></shape></item>
    <item android:state_focused="true"><shape><solid android:color="@color/selection_surface"/><corners android:radius="18dp"/><stroke android:width="2dp" android:color="@color/focus"/></shape></item>
    <item><shape><solid android:color="#99201C30"/><corners android:radius="18dp"/><stroke android:width="1dp" android:color="#806750A4"/></shape></item>
</selector>
