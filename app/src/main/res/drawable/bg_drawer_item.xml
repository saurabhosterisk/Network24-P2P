<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetLeft="12dp" android:insetRight="12dp" android:insetTop="2dp" android:insetBottom="2dp">
            <shape android:shape="rectangle"><solid android:color="#3A2C7A"/><corners android:radius="14dp"/><stroke android:width="3dp" android:color="#FFFFFF"/></shape>
        </inset>
    </item>
    <item android:state_focused="true">
        <inset android:insetLeft="12dp" android:insetRight="12dp" android:insetTop="2dp" android:insetBottom="2dp">
            <shape android:shape="rectangle"><solid android:color="#2A2160"/><corners android:radius="14dp"/><stroke android:width="3dp" android:color="#FFFFFF"/></shape>
        </inset>
    </item>
    <item android:state_hovered="true">
        <inset android:insetLeft="12dp" android:insetRight="12dp" android:insetTop="2dp" android:insetBottom="2dp">
            <shape android:shape="rectangle"><solid android:color="#2A2160"/><corners android:radius="14dp"/><stroke android:width="3dp" android:color="#FFFFFF"/></shape>
        </inset>
    </item>
    <item><shape android:shape="rectangle"><solid android:color="@android:color/transparent"/></shape></item>
</selector>
