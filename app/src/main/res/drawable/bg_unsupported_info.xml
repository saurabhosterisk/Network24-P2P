<?xml version="1.0" encoding="utf-8"?>
<!-- Left ("why") card on the unsupported-device screen: same shape as the
     offer card so the sides balance, but deliberately quiet (no fill, faint
     outline) so the eye goes to the Install card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#08FFFFFF" />
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="#1FFFFFFF" />
</shape>
