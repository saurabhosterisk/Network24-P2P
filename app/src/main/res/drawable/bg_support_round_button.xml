<?xml version="1.0" encoding="utf-8"?>
<!-- Round send / picture buttons; white ring on focus for the TV remote. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape android:shape="oval"><solid android:color="#556750A4"/></shape></item>
    <item android:state_pressed="true"><shape android:shape="oval"><solid android:color="@color/primary_dark"/></shape></item>
    <item android:state_focused="true"><shape android:shape="oval"><solid android:color="@color/primary"/><stroke android:width="2dp" android:color="@color/focus"/></shape></item>
    <item><shape android:shape="oval"><solid android:color="@color/primary"/></shape></item>
</selector>
