<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_dashboard">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerCard"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        app:cardBackgroundColor="@color/card"
        app:cardCornerRadius="12dp"
        app:strokeColor="@color/divider"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="16dp">
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_back_focus"
                android:padding="9dp"
                android:src="@drawable/ic_back"
                android:contentDescription="Back"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                app:tint="@android:color/white" />
            <View
                android:layout_width="3dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="12dp"
                android:background="@color/primary_light" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txtCategoryName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LIVE WITH EPG"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Live With EPG"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_more_focus"
                android:padding="7dp"
                android:src="@drawable/ic_more_vert"
                android:contentDescription="More options"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                app:tint="@android:color/white" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/topCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/card"
        app:cardCornerRadius="12dp"
        app:strokeColor="@color/divider"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/headerCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.30">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topCardInner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp">
            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@android:color/black"
                app:surface_type="texture_view"
                app:use_controller="false"
                app:show_buffering="never"
                app:layout_constraintWidth_percent="0.30"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
            <ProgressBar
                android:id="@+id/progressLoading"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="@id/playerView"
                app:layout_constraintBottom_toBottomOf="@id/playerView"
                app:layout_constraintStart_toStartOf="@id/playerView"
                app:layout_constraintEnd_toEndOf="@id/playerView" />
            <LinearLayout
                android:id="@+id/infoPanel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="12dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/playerView"
                app:layout_constraintEnd_toEndOf="parent">
                <TextView android:id="@+id/txtPlayerChannel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Select a channel" android:textColor="@android:color/white" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/txtChannelTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="EPG Preview" android:textColor="@color/primary_light" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/txtEpgStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Select a channel to play" android:textColor="@color/text_secondary" android:textSize="13sp" android:visibility="gone" />
                <TextView android:id="@+id/txtDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:textColor="@color/text_secondary" android:textSize="14sp" android:lineSpacingExtra="2dp" android:maxLines="5" android:ellipsize="end" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout android:id="@+id/epgArea" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="10dp" app:layout_constraintTop_toBottomOf="@id/topCard" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/stickyDate" android:layout_width="220dp" android:layout_height="40dp" android:gravity="center" android:text="CHANNELS" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" android:background="@color/card" android:elevation="8dp" />
        <HorizontalScrollView android:id="@+id/epgHeaderScroll" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginStart="220dp" android:scrollbars="none" android:fillViewport="false" android:elevation="7dp"><LinearLayout android:id="@+id/epgHeaderContainer" android:layout_width="wrap_content" android:layout_height="40dp" android:orientation="horizontal" /></HorizontalScrollView>
        <ScrollView android:id="@+id/channelVerticalScroll" android:layout_width="220dp" android:layout_height="match_parent" android:layout_marginTop="40dp" android:scrollbars="none" android:fillViewport="false" android:elevation="6dp"><LinearLayout android:id="@+id/channelContainer" android:layout_width="220dp" android:layout_height="wrap_content" android:orientation="vertical" /></ScrollView>
        <HorizontalScrollView android:id="@+id/epgHorizontalScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="220dp" android:layout_marginTop="40dp" android:scrollbars="horizontal" android:fillViewport="false"><ScrollView android:id="@+id/epgVerticalScroll" android:layout_width="wrap_content" android:layout_height="match_parent" android:scrollbars="vertical" android:fillViewport="false"><LinearLayout android:id="@+id/epgRowsContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" /></ScrollView></HorizontalScrollView>
    </FrameLayout>

    <com.network24.player.features.live.activity.EpgDrawerMenuBinder android:id="@+id/epgDrawerMenuBinder" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />

    <!-- ========================= -->
    <!-- Fullscreen Controls Overlay (shown only while topCard fills the -->
    <!-- whole screen - see enterFullscreen()/exitFullscreen()). Declared -->
    <!-- after topCard/epgArea so it draws above them in z-order; topCard's -->
    <!-- cardElevation is zeroed while fullscreen since CardView elevation -->
    <!-- is a real Z-translation that would otherwise draw it above these -->
    <!-- regardless of XML order. Reuses the same binding.playerView the -->
    <!-- whole time - no PlayerManager attach()/surface handoff happens on -->
    <!-- toggle, so there is nothing for that transition to freeze on. -->
    <!-- ========================= -->
    <View
        android:id="@+id/fsTopTint"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:background="#88000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageButton
        android:id="@+id/fsBtnBack"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_back_focus"
        android:contentDescription="Back"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="12dp"
        android:src="@drawable/ic_back"
        app:tint="@android:color/white"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/fsTopTint"
        app:layout_constraintBottom_toBottomOf="@id/fsTopTint"/>

    <TextView
        android:id="@+id/fsTxtChannelTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/fsTopTint"
        app:layout_constraintBottom_toBottomOf="@id/fsTopTint"
        app:layout_constraintStart_toEndOf="@id/fsBtnBack"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/fsBottomOverlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#C0000000"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Now-playing program line (this screen's EPG is the full -->
        <!-- timeline grid, not a simple Now/Next card, so the fullscreen -->
        <!-- overlay keeps a single current-program line instead). -->
        <TextView
            android:id="@+id/fsTxtNowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="No Program Info"
            android:textColor="#DDDDDD"
            android:textSize="13sp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:background="@android:color/transparent"/>

        <!-- Playback controls row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/fsBtnInfo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:background="@drawable/bg_btn_focus_selector"
                android:src="@drawable/ic_info"
                android:tint="#FFFFFF"
                android:focusable="true"/>

            <Space android:layout_width="8dp" android:layout_height="1dp"/>

            <ImageButton
                android:id="@+id/fsBtnAspect"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:background="@drawable/bg_btn_focus_selector"
                android:src="@drawable/ic_aspect"
                android:tint="#FFFFFF"
                android:focusable="true"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/fsBtnPrev"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_btn_focus_selector"
                    android:src="@drawable/ic_prev"
                    android:tint="#FFFFFF"
                    android:focusable="true"/>

                <Space android:layout_width="12dp" android:layout_height="1dp"/>

                <ImageButton
                    android:id="@+id/fsBtnPlayPause"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_btn_focus_selector"
                    android:src="@drawable/ic_pause"
                    android:tint="#FFFFFF"
                    android:focusable="true"/>

                <Space android:layout_width="12dp" android:layout_height="1dp"/>

                <ImageButton
                    android:id="@+id/fsBtnNext"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_btn_focus_selector"
                    android:src="@drawable/ic_next"
                    android:tint="#FFFFFF"
                    android:focusable="true"/>
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <Space android:layout_width="8dp" android:layout_height="1dp"/>

            <ImageButton
                android:id="@+id/fsBtnSubtitle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:background="@drawable/bg_btn_focus_selector"
                android:src="@drawable/ic_cc_on"
                android:tint="#FFFFFF"
                android:focusable="true"/>

            <ImageButton
                android:id="@+id/fsBtnGrid"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:background="@drawable/bg_btn_focus_selector"
                android:src="@drawable/ic_grid"
                android:tint="#FFFFFF"
                android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.navigation.NavigationView android:id="@+id/rightNav" android:layout_width="340dp" android:layout_height="match_parent" android:layout_gravity="end" android:background="@android:color/white" app:itemBackground="@drawable/bg_navigation_item" app:itemIconTint="@color/navigation_item_content" app:itemTextColor="@color/navigation_item_content" app:menu="@menu/menu_live_right_drawer" />
</androidx.drawerlayout.widget.DrawerLayout>
