<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Parental Lock: choose the locked categories and the PIN (same lock as play.web24.live) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="18dp"
    android:paddingEnd="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/parentalBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_back_focus"
            android:contentDescription="Back"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Parental Lock"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_more_focus"
            android:contentDescription="Open menu"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/text_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/parentalStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="12dp"
        android:text="Lock categories with a PIN. Their channels are hidden from Live TV, Favorites, Recently Watched and search until the PIN is entered. The lock is saved in your account, so it also works on play.web24.live."
        android:textColor="@color/text_hint"
        android:textSize="14sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvParental"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:scrollbars="none" />

        <ProgressBar
            android:id="@+id/progressParental"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/pinFirst"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_support_input"
            android:gravity="center"
            android:importantForAutofill="no"
            android:inputType="numberPassword"
            android:maxLength="8"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/pinSecond"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_support_input"
            android:gravity="center"
            android:importantForAutofill="no"
            android:inputType="numberPassword"
            android:maxLength="8"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="17sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/parentalError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#FF6B6B"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnLockNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_settings_action"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="120dp"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:text="Lock now"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnLockOff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_settings_action"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="120dp"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:text="Turn off"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnLockSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_primary_action"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="160dp"
            android:paddingStart="22dp"
            android:paddingTop="12dp"
            android:paddingEnd="22dp"
            android:paddingBottom="12dp"
            android:text="Turn on"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
