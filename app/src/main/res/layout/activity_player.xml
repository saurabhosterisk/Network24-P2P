<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Full-screen video surface -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:surface_type="texture_view"
        app:use_controller="false"
        app:show_buffering="never"
        app:resize_mode="fit"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 🔥 Ye naya Error TextView hai jo Center me aayega -->
    <TextView
        android:id="@+id/txtPlayerError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:layout_constraintTop_toTopOf="@+id/playerView"
        app:layout_constraintBottom_toBottomOf="@+id/playerView"
        app:layout_constraintStart_toStartOf="@+id/playerView"
        app:layout_constraintEnd_toEndOf="@+id/playerView"
        android:gravity="center"
        android:text="Sorry, This video can not be played.\nPlease try again or pick another video."
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:background="#99000000"
        android:padding="12dp"
        android:visibility="gone" />


    <!-- Centered spinner (appear while buffering if you want to control from code) -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top translucent channel title bar -->
    <View
        android:id="@+id/topTint"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_player_top"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="36dp"
        android:background="@drawable/bg_player_btn"
        android:contentDescription="Back"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/ic_back"
        app:tint="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/topTint"
        app:layout_constraintBottom_toBottomOf="@id/topTint" />

    <TextView
        android:id="@+id/txtChannelTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="4725 - USA-SD | AE"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:alpha="0.85"
        android:shadowColor="#AA000000"
        android:shadowRadius="8"
        app:layout_constraintTop_toTopOf="@id/topTint"
        app:layout_constraintBottom_toBottomOf="@id/topTint"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintEnd_toStartOf="@id/btnMore" />

    <!-- Hidden: no full-screen player has a menu button (same as the Live TV,
         Favorites and EPG full screen); Back returns to a screen that has one. -->
    <ImageButton
        android:id="@+id/btnMore"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_more_focus"
        android:contentDescription="Open menu"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/ic_more_vert"
        android:tint="@android:color/white"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/topTint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/topTint" />

    <!-- Bottom overlay container (EPG + controls) -->
    <LinearLayout
        android:id="@+id/bottomOverlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="70dp"
        android:paddingBottom="22dp"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="@drawable/bg_player_scrim"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- channel: logo, name, LIVE and the time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <ImageView
                android:id="@+id/imgChannelLogo"
                android:layout_width="64dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:contentDescription="Channel logo" />

            <TextView
                android:id="@+id/txtOverlayChannel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#F2F3F5"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_player_pill"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:letterSpacing="0.12"
                android:text="LIVE"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtChannelNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_player_chip"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="#C9CDD4"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="#F2F3F5"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- NOW row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/labelNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOW"
                android:letterSpacing="0.12"
                android:textColor="#A894FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtNowTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="No Program Info"
                android:textColor="#F2F3F5"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtNowTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03:01 PM - 03:31 PM"
                android:textColor="#C9CDD4"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Progress bar (EPG progress strip) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp">

            <View
                android:id="@+id/epgTrack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_player_track" />

            <View
                android:id="@+id/epgProgress"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@drawable/bg_player_progress" />
        </FrameLayout>

        <!-- NEXT row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/labelNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEXT"
                android:letterSpacing="0.12"
                android:textColor="#9BA1AD"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtNextTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#B0B5BF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtNextTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03:31 PM - 04:00 PM"
                android:textColor="#9BA1AD"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- the focused button's name -->
        <TextView
            android:id="@+id/txtFocusLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:textColor="#C9CDD4"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Controls: a glass dock for watching (guide, MultiView, chat, AI) on the left, the play cluster in the
             middle, a dock for picture / sound / connection on the right. Equal-width sides keep Play centred. -->
        <LinearLayout
            android:id="@+id/controlsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="6dp"
                    android:background="@drawable/bg_player_dock">
                    <ImageButton
                        android:id="@+id/btnProgram"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_player_btn_flat"
                        android:contentDescription="What's on"
                        android:src="@drawable/ic_program_info"
                        android:tint="#FFFFFF"
                        android:focusable="true" />
                    <ImageButton
                        android:id="@+id/btnGrid"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_player_btn_flat"
                        android:contentDescription="MultiView"
                        android:src="@drawable/ic_grid"
                        android:tint="#FFFFFF"
                        android:focusable="true" />
                    <ImageButton
                        android:id="@+id/btnChat"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_player_btn_flat"
                        android:contentDescription="Live chat"
                        android:src="@drawable/ic_watch_chat"
                        android:tint="#FFFFFF"
                        android:focusable="true" />
                    <ImageButton
                        android:id="@+id/btnAi"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_player_btn_flat"
                        android:contentDescription="AI assistant"
                        android:src="@drawable/ic_ai"
                        android:tint="#FFFFFF"
                        android:focusable="true" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <ImageButton
                    android:id="@+id/btnPrev"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:padding="15dp"
                    android:background="@drawable/bg_player_btn"
                    android:contentDescription="Previous channel"
                    android:src="@drawable/ic_prev"
                    android:tint="#FFFFFF"
                    android:focusable="true" />
                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:padding="20dp"
                    android:background="@drawable/bg_player_play"
                    android:contentDescription="Play / pause"
                    android:src="@drawable/ic_pause"
                    android:tint="#FFFFFF"
                    android:focusable="true" />
                <ImageButton
                    android:id="@+id/btnNext"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:padding="15dp"
                    android:background="@drawable/bg_player_btn"
                    android:contentDescription="Next channel"
                    android:src="@drawable/ic_next"
                    android:tint="#FFFFFF"
                    android:focusable="true" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="6dp"
                    android:layout_gravity="end"
                    android:background="@drawable/bg_player_dock">
                    <ImageButton
                        android:id="@+id/btnSubtitle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_player_btn_flat"
                        android:contentDescription="Subtitles"
                        android:src="@drawable/ic_cc_on"
                        android:tint="#FFFFFF"
                        android:focusable="true" />
                    <ImageButton
                        android:id="@+id/btnAutoVolume"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_player_btn_flat"
                        android:contentDescription="Auto volume"
                        android:src="@drawable/ic_auto_volume"
                        android:tint="#FFFFFF"
                        android:focusable="true" />
                    <ImageButton
                        android:id="@+id/btnDecoder"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_player_btn_flat"
                        android:contentDescription="Decoding (hardware / software)"
                        android:src="@drawable/ic_decoder"
                        android:tint="#FFFFFF"
                        android:focusable="true" />
                    <ImageButton
                        android:id="@+id/btnInfo"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_player_btn_flat"
                        android:contentDescription="Stream info"
                        android:src="@drawable/ic_info"
                        android:tint="#FFFFFF"
                        android:focusable="true" />
                    <ImageButton
                        android:id="@+id/btnVpn"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_player_btn_flat"
                        android:contentDescription="VPN"
                        android:src="@drawable/ic_vpn"
                        android:tint="#FFFFFF"
                        android:focusable="true" />
                    <ImageButton
                        android:id="@+id/btnVpnRotate"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_player_btn_flat"
                        android:contentDescription="Change VPN server"
                        android:src="@drawable/ic_refresh"
                        android:tint="#FFFFFF"
                        android:visibility="gone"
                        android:focusable="true" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
