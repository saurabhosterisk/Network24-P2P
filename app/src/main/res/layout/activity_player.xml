<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Full-screen video surface -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:surface_type="texture_view"
        app:use_controller="false"
        app:show_buffering="never"
        app:resize_mode="fit"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 🔥 Ye naya Error TextView hai jo Center me aayega -->
    <TextView
        android:id="@+id/txtPlayerError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:layout_constraintTop_toTopOf="@+id/playerView"
        app:layout_constraintBottom_toBottomOf="@+id/playerView"
        app:layout_constraintStart_toStartOf="@+id/playerView"
        app:layout_constraintEnd_toEndOf="@+id/playerView"
        android:gravity="center"
        android:text="Sorry, This video can not be played.\nPlease try again or pick another video."
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:background="#99000000"
        android:padding="12dp"
        android:visibility="gone" />


    <!-- Centered spinner (appear while buffering if you want to control from code) -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top translucent channel title bar -->
    <View
        android:id="@+id/topTint"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:background="#88000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_back_focus"
        android:contentDescription="Back"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="12dp"
        android:src="@drawable/ic_back"
        app:tint="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/topTint"
        app:layout_constraintBottom_toBottomOf="@id/topTint" />

    <TextView
        android:id="@+id/txtChannelTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="4725 - USA-SD | AE"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/topTint"
        app:layout_constraintBottom_toBottomOf="@id/topTint"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintEnd_toStartOf="@id/btnMore" />

    <ImageButton
        android:id="@+id/btnMore"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_more_focus"
        android:contentDescription="Open menu"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="12dp"
        android:src="@drawable/ic_more_vert"
        android:tint="@android:color/white"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/topTint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/topTint" />

    <!-- Bottom overlay container (EPG + controls) -->
    <LinearLayout
        android:id="@+id/bottomOverlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#C0000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- NOW row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/labelNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Now:"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtNowTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="No Program Info"
                android:textColor="#DDDDDD"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtNowTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03:01 PM - 03:31 PM"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Progress bar (EPG progress strip) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp">

            <View
                android:id="@+id/epgTrack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#333333" />

            <View
                android:id="@+id/epgProgress"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="#FFC107" />
        </FrameLayout>

        <!-- NEXT row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/labelNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next:"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtNextTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#DDDDDD"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtNextTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03:31 PM - 04:00 PM"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:background="@android:color/transparent" />

        <!-- Playback controls row -->
        <LinearLayout
            android:id="@+id/controlsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Info Button -->
            <ImageButton
                android:id="@+id/btnInfo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:background="@drawable/bg_btn_focus_selector"
                android:src="@drawable/ic_info"
                android:tint="#FFFFFF"
                android:focusable="true" />

            <Space android:layout_width="8dp" android:layout_height="1dp" />

            <!-- Aspect Ratio Button -->
            <ImageButton
                android:id="@+id/btnAspect"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:background="@drawable/bg_btn_focus_selector"
                android:src="@drawable/ic_aspect"
                android:tint="#FFFFFF"
                android:focusable="true" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Center Controls (Prev, Play, Next) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnPrev"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_btn_focus_selector"
                    android:src="@drawable/ic_prev"
                    android:tint="#FFFFFF"
                    android:focusable="true" />

                <Space android:layout_width="12dp" android:layout_height="1dp" />

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_btn_focus_selector"
                    android:src="@drawable/ic_pause"
                    android:tint="#FFFFFF"
                    android:focusable="true" />

                <Space android:layout_width="12dp" android:layout_height="1dp" />

                <ImageButton
                    android:id="@+id/btnNext"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_btn_focus_selector"
                    android:src="@drawable/ic_next"
                    android:tint="#FFFFFF"
                    android:focusable="true" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />



            <Space android:layout_width="8dp" android:layout_height="1dp" />

            <!-- CC (Subtitle) Button -->
            <ImageButton
                android:id="@+id/btnSubtitle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:background="@drawable/bg_btn_focus_selector"
                android:src="@drawable/ic_cc_on"
                android:tint="#FFFFFF"
                android:focusable="true" />

            <!-- Grid Button -->
            <ImageButton
                android:id="@+id/btnGrid"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:background="@drawable/bg_btn_focus_selector"
                android:src="@drawable/ic_grid"
                android:tint="#FFFFFF"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
