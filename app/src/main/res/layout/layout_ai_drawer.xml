<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen player's AI assistant: a semi-transparent panel on the right
     so the channel keeps playing (and stays visible) behind it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aiPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ai_drawer"
    android:clickable="true"
    android:focusable="false"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Header: who, and whether the AI server is alive -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:src="@drawable/app_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="N24 Support AI"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/aiOnline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Connecting…"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Wipes this customer's chat (theirs only) -->
        <TextView
            android:id="@+id/aiClear"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_outline_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Clear"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/aiClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_back_focus"
            android:contentDescription="Close"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            android:tint="@color/text_primary" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/aiScroll"
        android:foreground="@drawable/bg_ai_scroll_focus"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/aiMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="vertical" />
    </ScrollView>

    <!-- "N24 Support is typing..." -->
    <TextView
        android:id="@+id/aiStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/primary_light"
        android:textSize="12sp"
        android:textStyle="italic"
        android:visibility="gone" />

    <!-- Ready-made questions: quicker than typing with a TV remote -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/aiChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/aiInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_support_input"
            android:hint="Ask anything about Network24…"
            android:imeOptions="actionSend|flagNoExtractUi"
            android:inputType="textCapSentences"
            android:maxLength="600"
            android:minHeight="44dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/aiSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_support_round_button"
            android:contentDescription="Send"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_send" />
    </LinearLayout>
</LinearLayout>
