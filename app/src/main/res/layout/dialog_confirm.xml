<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="560dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_window"
    android:padding="24dp">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:lineSpacingExtra="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal"
        android:gravity="end">

        <!-- Same bg_settings_action / bg_primary_action drawables used across
             the rest of the app (Dashboard tiles, Settings rows) - same
             maroon-fill + white-outline focus state everywhere, not a
             different effect per button. -->
        <TextView
            android:id="@+id/dialogNegative"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_settings_action"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:minWidth="120dp"
            android:gravity="center"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusRight="@id/dialogPositive" />

        <TextView
            android:id="@+id/dialogPositive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_primary_action"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="15sp"
            android:minWidth="120dp"
            android:gravity="center"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusLeft="@id/dialogNegative" />
    </LinearLayout>
</LinearLayout>
