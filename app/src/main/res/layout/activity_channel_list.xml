<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAIN CONTENT ROOT -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_dashboard">

        <!-- ========================= -->
        <!-- Header -->
        <!-- ========================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/headerCard"
            android:layout_width="0dp"
            android:layout_height="74dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Back Button -->
                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_back_focus"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:src="@drawable/ic_back"
                    app:tint="@android:color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <!-- Category Title -->
                <TextView
                    android:id="@+id/txtCategoryName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:text="USA ENTERTAINMENT"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    app:layout_constraintStart_toEndOf="@id/btnBack"
                    app:layout_constraintEnd_toStartOf="@id/searchLayout"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <!-- Search Box -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/searchLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="320dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="12dp"
                    app:startIconDrawable="@android:drawable/ic_menu_search"
                    app:boxBackgroundColor="@color/card"
                    app:boxStrokeColor="@color/search_field_stroke"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:layout_constraintEnd_toStartOf="@id/btnMore"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Search Channels"
                        android:textColor="@android:color/white"
                        android:textColorHint="@color/text_hint"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:inputType="text"
                        android:imeOptions="actionSearch|flagNoExtractUi"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 3-dots Menu Button -->
                <ImageView
                    android:id="@+id/btnMore"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@android:color/white"
                    android:focusable="true"
                    android:clickable="true"
                    android:padding="6dp"
                    android:background="@drawable/bg_more_focus"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========================= -->
        <!-- Guidelines -->
        <!-- ========================= -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideVertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.35"/>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideHorizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.80"/>

        <!-- ========================= -->
        <!-- Left Panel (Channel List) -->
        <!-- ========================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChannels"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/headerCard"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guideVertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChannels"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:descendantFocusability="afterDescendants"
                android:padding="8dp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========================= -->
        <!-- Player Card -->
        <!-- ========================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPlayer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/headerCard"
            app:layout_constraintBottom_toTopOf="@id/guideHorizontal"
            app:layout_constraintStart_toStartOf="@id/guideVertical"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@android:color/black"
                    android:focusable="false"
                    app:surface_type="texture_view"
                    app:show_buffering="when_playing"
                    app:use_controller="false"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- 🔥 Ye naya Error TextView hai jo Center me aayega -->
                <TextView
                    android:id="@+id/txtPlayerError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:layout_constraintTop_toTopOf="@+id/playerView"
                    app:layout_constraintBottom_toBottomOf="@+id/playerView"
                    app:layout_constraintStart_toStartOf="@+id/playerView"
                    app:layout_constraintEnd_toEndOf="@+id/playerView"
                    android:gravity="center"
                    android:text="Sorry, This video can not be played.\nPlease try again or pick another video."
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:background="#99000000"
                    android:padding="12dp"
                    android:visibility="gone" />


                <ProgressBar
                    android:id="@+id/progressLoading"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <ImageButton
                    android:id="@+id/btnFullscreen"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_more_focus"
                    android:padding="8dp"
                    android:src="@drawable/ic_fullscreen"
                    app:tint="@android:color/white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <LinearLayout
                    android:id="@+id/layoutOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:id="@+id/txtOverlayChannel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AE HD"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="18sp"/>

                    <TextView
                        android:id="@+id/txtOverlayProgram"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="The First 48"
                        android:textColor="#DDFFFFFF"
                        android:textSize="14sp"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========================= -->
        <!-- EPG Card -->
        <!-- ========================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEpg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/guideHorizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideVertical"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- NOW -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NOW"
                            android:textColor="#64B5F6"
                            android:textStyle="bold"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/txtNowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="The First 48"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtNowTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="08:00 PM - 09:00 PM"
                            android:textColor="#9E9E9E"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- NEXT -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NEXT"
                            android:textColor="#81C784"
                            android:textStyle="bold"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/txtNextTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Court Cam"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtNextTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="09:00 PM - 10:00 PM"
                            android:textColor="#9E9E9E"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========================= -->
        <!-- Fullscreen Controls Overlay (shown only while cardPlayer -->
        <!-- fills the whole screen - see enterFullscreen()/exitFullscreen() -->
        <!-- in ChannelListActivity). Sits above cardPlayer/cardChannels/ -->
        <!-- cardEpg in z-order since it is declared after them. Reuses the -->
        <!-- same binding.playerView the whole time - no PlayerManager -->
        <!-- attach()/surface handoff happens when toggling fullscreen, so -->
        <!-- there is nothing here for that transition to freeze on. -->
        <!-- ========================= -->
        <View
            android:id="@+id/fsTopTint"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:background="#88000000"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ImageButton
            android:id="@+id/fsBtnBack"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_back_focus"
            android:contentDescription="Back"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="@android:color/white"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/fsTopTint"
            app:layout_constraintBottom_toBottomOf="@id/fsTopTint"/>

        <TextView
            android:id="@+id/fsTxtChannelTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/fsTopTint"
            app:layout_constraintBottom_toBottomOf="@id/fsTopTint"
            app:layout_constraintStart_toEndOf="@id/fsBtnBack"
            app:layout_constraintEnd_toEndOf="parent"/>

        <LinearLayout
            android:id="@+id/fsBottomOverlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="16dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#C0000000"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- NOW row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Now:"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/fsTxtNowTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="No Program Info"
                    android:textColor="#DDDDDD"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/fsTxtNowTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- Progress bar (EPG progress strip) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp">

                <View
                    android:id="@+id/fsEpgTrack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#333333"/>

                <View
                    android:id="@+id/fsEpgProgress"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:background="#FFC107"/>
            </FrameLayout>

            <!-- NEXT row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next:"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/fsTxtNextTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#DDDDDD"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/fsTxtNextTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:background="@android:color/transparent"/>

            <!-- Playback controls row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/fsBtnInfo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="10dp"
                    android:background="@drawable/bg_btn_focus_selector"
                    android:src="@drawable/ic_info"
                    android:tint="#FFFFFF"
                    android:focusable="true"/>

                <Space android:layout_width="8dp" android:layout_height="1dp"/>

                <ImageButton
                    android:id="@+id/fsBtnVpn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="10dp"
                    android:background="@drawable/bg_btn_focus_selector"
                    android:src="@drawable/ic_vpn"
                    android:tint="#FFFFFF"
                    android:focusable="true"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/fsBtnPrev"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:padding="14dp"
                        android:background="@drawable/bg_btn_focus_selector"
                        android:src="@drawable/ic_prev"
                        android:tint="#FFFFFF"
                        android:focusable="true"/>

                    <Space android:layout_width="12dp" android:layout_height="1dp"/>

                    <ImageButton
                        android:id="@+id/fsBtnPlayPause"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:padding="16dp"
                        android:background="@drawable/bg_btn_focus_selector"
                        android:src="@drawable/ic_pause"
                        android:tint="#FFFFFF"
                        android:focusable="true"/>

                    <Space android:layout_width="12dp" android:layout_height="1dp"/>

                    <ImageButton
                        android:id="@+id/fsBtnNext"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:padding="14dp"
                        android:background="@drawable/bg_btn_focus_selector"
                        android:src="@drawable/ic_next"
                        android:tint="#FFFFFF"
                        android:focusable="true"/>
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <Space android:layout_width="8dp" android:layout_height="1dp"/>

                <ImageButton
                    android:id="@+id/fsBtnSubtitle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="10dp"
                    android:background="@drawable/bg_btn_focus_selector"
                    android:src="@drawable/ic_cc_on"
                    android:tint="#FFFFFF"
                    android:focusable="true"/>

                <ImageButton
                    android:id="@+id/fsBtnGrid"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="10dp"
                    android:background="@drawable/bg_btn_focus_selector"
                    android:src="@drawable/ic_grid"
                    android:tint="#FFFFFF"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ========================= -->
    <!-- Right Side Menu Drawer -->
    <!-- ========================= -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/rightNav"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@android:color/white"
        app:itemBackground="@drawable/bg_navigation_item"
        app:itemIconTint="@color/navigation_item_content"
        app:itemTextColor="@color/navigation_item_content"
        app:menu="@menu/menu_live_right_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
