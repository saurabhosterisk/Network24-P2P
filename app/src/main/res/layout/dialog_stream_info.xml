<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10141D"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="STREAM INFORMATION &amp; DIAGNOSTICS"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSummary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="#1A2230"
        app:cardCornerRadius="14dp"
        app:strokeColor="#33425A"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@id/detailButtonsScroll"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CURRENT ASSESSMENT"
                        android:textColor="#8BB8FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDiagnosisCause"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Checking stream health"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HEALTH SCORE"
                        android:textColor="#8B98AC"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHealthScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="- / 100"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHealthLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="#FFD166"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvDiagnosis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Run AUTO CHECK to collect evidence."
                android:textColor="#E7ECF5"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvDiagnosisEvidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Evidence: -"
                android:textColor="#9BA8BB"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDiagnosisAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Action: -"
                android:textColor="#FFD166"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REBUFFERS"
                    android:textColor="#8B98AC"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRebufferCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="-"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="BUFFERING TIME"
                    android:textColor="#8B98AC"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBufferingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="-"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDetails"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="#151C28"
        app:cardCornerRadius="14dp"
        app:strokeColor="#2E3B51"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@id/detailButtonsScroll"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvDetailSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OVERVIEW"
                android:textColor="#8BB8FF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/detailScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="7dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="top"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:descendantFocusability="blocksDescendants"
                android:nextFocusDown="@id/btnRunDiagnosis">

                <LinearLayout
                    android:id="@+id/tvDetailBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <HorizontalScrollView
        android:id="@+id/detailButtonsScroll"
        android:layout_width="0dp"
                android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:focusable="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRunDiagnosis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RUN AUTO CHECK"
                android:textSize="11sp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_diagnostics_button"
                android:backgroundTint="@null"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:nextFocusRight="@id/btnSpeedTest"
                android:nextFocusUp="@id/detailScrollView"
                android:minHeight="44dp"
                android:minWidth="110dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnSpeedTest"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="SPEEDTEST"
                android:textSize="11sp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_diagnostics_button"
                android:backgroundTint="@null"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:nextFocusLeft="@id/btnRunDiagnosis"
                android:nextFocusRight="@id/btnOverview"
                android:nextFocusUp="@id/detailScrollView"
                android:minHeight="44dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnOverview"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="OVERVIEW"
                android:textSize="11sp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_diagnostics_button"
                android:backgroundTint="@null"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:nextFocusLeft="@id/btnSpeedTest"
                android:nextFocusRight="@id/btnStreamDetails"
                android:nextFocusUp="@id/detailScrollView"
                android:minHeight="44dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnStreamDetails"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="STREAM"
                android:textSize="11sp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_diagnostics_button"
                android:backgroundTint="@null"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:nextFocusLeft="@id/btnOverview"
                android:nextFocusRight="@id/btnNetworkDetails"
                android:nextFocusUp="@id/detailScrollView"
                android:minHeight="44dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnNetworkDetails"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="NETWORK"
                android:textSize="11sp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_diagnostics_button"
                android:backgroundTint="@null"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:nextFocusLeft="@id/btnStreamDetails"
                android:nextFocusRight="@id/btnDeviceDetails"
                android:nextFocusUp="@id/detailScrollView"
                android:minHeight="44dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnDeviceDetails"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="DEVICE"
                android:textSize="11sp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_diagnostics_button"
                android:backgroundTint="@null"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:nextFocusLeft="@id/btnNetworkDetails"
                android:nextFocusRight="@id/btnEventsDetails"
                android:nextFocusUp="@id/detailScrollView"
                android:minHeight="44dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnEventsDetails"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="EVENTS"
                android:textSize="11sp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_diagnostics_button"
                android:backgroundTint="@null"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:nextFocusLeft="@id/btnDeviceDetails"
                android:nextFocusRight="@id/btnClose"
                android:nextFocusUp="@id/detailScrollView"
                android:minHeight="44dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnClose"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="CLOSE"
                android:textSize="11sp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_diagnostics_button"
                android:backgroundTint="@null"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@id/btnEventsDetails"
                android:nextFocusUp="@id/detailScrollView"
                android:minHeight="44dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center" />
        </LinearLayout>
    </HorizontalScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
