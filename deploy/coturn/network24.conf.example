# Install as /etc/turnserver.conf after review. Do not commit the real secret.
# coturn must be enabled only after UDP/TCP 3478, TLS TCP 5349, and the relay
# port range are allowed by the host firewall/security group.

listening-port=3478
tls-listening-port=5349
listening-ip=PUBLIC_IP
relay-ip=PUBLIC_IP
external-ip=PUBLIC_IP
realm=p2p.web24.live
fingerprint
lt-cred-mech
use-auth-secret
static-auth-secret=INJECT_FROM_ROOT_ONLY_SECRET_STORE
no-cli
no-multicast-peers
no-loopback-peers
stale-nonce=600
no-tcp-relay
min-port=49152
max-port=65535
log-file=stdout
simple-log
