rules_version = '2';

// Firestore for the Network24 app (project "network24").
// The app has no Firebase login yet, so the two per-account documents are
// reachable by their id (the account username) without auth - but they can no
// longer be listed (which exposed every customer username), deleted, or filled
// with arbitrary data. Everything else, including the retired "rooms" chat,
// is closed. Server-side tools with a service account bypass these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // user_favorites/{username}: { items: ["live:123", ...], updatedAtMs }
    match /user_favorites/{userId} {
      allow get: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['items', 'updatedAtMs'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 2000
        && request.resource.data.updatedAtMs is int;
    }

    // user_category_settings/{username}: { disabledIds: ["12", ...], updatedAtMs }
    match /user_category_settings/{userId} {
      allow get: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['disabledIds', 'updatedAtMs'])
        && request.resource.data.disabledIds is list
        && request.resource.data.disabledIds.size() <= 1000
        && request.resource.data.updatedAtMs is int;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
